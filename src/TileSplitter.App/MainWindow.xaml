<Window x:Class="TileSplitter.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TileSplitter.App" Title="{Binding Title}" Width="1200" Height="800" MinWidth="850" MinHeight="550">
 <DockPanel>
  <WrapPanel DockPanel.Dock="Top" Margin="6">
   <Button Content="_New / Atlas" Click="NewAtlas" ToolTip="Ctrl+N" Padding="8,4"/>
   <Button Content="_Open Project" Click="OpenProject" ToolTip="Ctrl+O" Padding="8,4"/>
   <Button Content="_Save" Click="SaveProject" ToolTip="Ctrl+S" Padding="8,4"/>
   <Button Content="Save _As" Click="SaveProjectAs" ToolTip="Ctrl+Shift+S" Padding="8,4"/>
   <Button Content="_Undo" Command="{Binding UndoCommand}" ToolTip="Ctrl+Z" Padding="8,4"/>
   <Button Content="_Redo" Command="{Binding RedoCommand}" ToolTip="Ctrl+Y" Padding="8,4"/>
   <Button Content="_Export" Click="Export" ToolTip="Ctrl+E" Padding="8,4"/>
   <Button Content="_Fit" Click="Fit" ToolTip="Ctrl+0" Padding="8,4"/>
   <Button Content="100%" Click="ActualSize" ToolTip="Ctrl+1" Padding="8,4"/>
   <Button Content="Grid" Click="ToggleGrid" ToolTip="Ctrl+G" Padding="8,4"/>
   <Button Content="Labels" Click="ToggleLabels" ToolTip="Ctrl+L" Padding="8,4"/>
   <Button Content="Grid size" Click="GridSize" ToolTip="Ctrl+Shift+G: clears regions (undoable)" Padding="8,4"/>
  </WrapPanel>
  <StatusBar DockPanel.Dock="Bottom"><TextBlock Text="{Binding Summary}"/><Separator/><TextBlock x:Name="Feedback" Text="Ready"/></StatusBar>
  <Grid x:Name="Workspace">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
   <local:AtlasViewport x:Name="Viewport"/>
   <DockPanel Grid.Column="1" Margin="10">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="Textures" FontWeight="Bold" FontSize="18"/>
     <Button Content="New Texture" Command="{Binding NewTextureCommand}" ToolTip="Ctrl+T" Margin="0,8"/>
     <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by ID or name (Ctrl+F)" x:Name="SearchBox" AutomationProperties.Name="Search textures"/>
     <TextBlock Text="Assignment mode" Margin="0,10,0,3"/>
     <ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="ModeChanged" ToolTip="Ctrl+2 Add, Ctrl+3 Replace, Ctrl+4 Erase" AutomationProperties.Name="Assignment mode"><ComboBoxItem>Add tiles</ComboBoxItem><ComboBoxItem>Replace region</ComboBoxItem><ComboBoxItem>Erase tiles</ComboBoxItem></ComboBox>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
     <TextBlock Text="Selected texture" FontWeight="Bold"/>
     <TextBlock Text="{Binding SelectedDimensions}" Margin="0,4"/>
     <TextBox x:Name="NameBox" Text="{Binding Selected.Name, Mode=OneWay}" LostKeyboardFocus="Rename" KeyDown="NameKey" ToolTip="Edit name, Enter to apply (F2)" AutomationProperties.Name="Texture name" Margin="0,6"/>
     <WrapPanel><Button Content="Color" Click="ChangeColor" ToolTip="Ctrl+Shift+C" Padding="8,4"/><Button Content="Clear region" Command="{Binding ClearCommand}" ToolTip="Ctrl+Backspace" Padding="8,4"/><Button Content="Delete" Command="{Binding DeleteCommand}" ToolTip="Ctrl+Delete" Padding="8,4"/></WrapPanel>
    </StackPanel>
    <ListBox ItemsSource="{Binding Textures}" SelectedItem="{Binding Selected}" Margin="0,8" AutomationProperties.Name="Texture list">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,4"><StackPanel Orientation="Horizontal"><Rectangle Fill="{Binding Color}" Width="12" Height="12" Margin="0,0,6,0"/><TextBlock Text="{Binding Id}" FontWeight="Bold"/><TextBlock Text="{Binding Name}" Margin="8,0" MaxWidth="185" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></StackPanel><TextBlock Text="{Binding Region}" FontSize="10" Foreground="DimGray" MaxWidth="240" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
